<view class="container">
  <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
    <text class="icon">📷</text>
    <text class="text">暂无处理记录</text>
  </view>
  <view class="h-item" wx:for="{{list}}" wx:key="_id">
    <image class="h-thumb" src="{{item.thumbUrl}}" mode="aspectFill" />
    <view class="h-info">
      <view class="h-title">{{item.label}} · {{item.subLabel}}</view>
      <view class="h-date">{{item.created_at}}</view>
      <view class="h-status {{item.is_downloaded ? 'paid' : 'free'}}">
        {{item.is_downloaded ? '已付费' : '待下载'}}
      </view>
    </view>
    <view class="h-btns">
      <button class="h-btn" bindtap="download" data-id="{{item._id}}">下载</button>
      <button class="h-btn h-btn-reprocess" bindtap="reprocess" data-id="{{item._id}}" data-category="{{item.process_type}}" data-fileid="{{item.original_url}}">重新处理</button>
    </view>
  </view>
</view>
