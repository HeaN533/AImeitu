.category-section { margin-bottom: 32rpx; }
.cat-header { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.model-item { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 8rpx; padding: 20rpx; margin-bottom: 8rpx; }
.model-info { flex: 1; min-width: 0; }
.model-name { font-size: 26rpx; color: #333; font-weight: bold; margin-bottom: 6rpx; }
.model-row { display: flex; font-size: 22rpx; margin-bottom: 2rpx; }
.model-label { color: #999; width: 70rpx; flex-shrink: 0; }
.model-value { color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-value { color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-panel { position: fixed; left: 5%; right: 5%; top: 10%; bottom: 10%; background: #fff; border-radius: 16rpx; z-index: 101; padding: 32rpx; overflow-y: auto; }
.modal-title { font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 28rpx; text-align: center; }

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #333; margin-bottom: 8rpx; }
.form-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 26rpx; width: 100%; box-sizing: border-box; }
.form-textarea { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 24rpx; width: 100%; min-height: 100rpx; box-sizing: border-box; }
.picker-val { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 26rpx; color: #333; }
.show-key-switch { display: inline-block; vertical-align: middle; margin-left: 8rpx; transform: scale(0.7); }
.show-key-label { font-size: 22rpx; color: #999; vertical-align: middle; }

.form-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.form-actions button { flex: 1; }
