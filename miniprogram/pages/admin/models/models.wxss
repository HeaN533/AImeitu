.category-section { margin-bottom: 32rpx; position: relative; z-index: 1; }
.cat-header { font-size: 28rpx; font-weight: bold; color: var(--text); margin-bottom: 12rpx; }
.model-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.model-info { flex: 1; min-width: 0; }
.model-name { font-size: 26rpx; color: var(--text); font-weight: bold; margin-bottom: 6rpx; }
.model-row { display: flex; font-size: 22rpx; margin-bottom: 2rpx; }
.model-label { color: var(--text-secondary); width: 70rpx; flex-shrink: 0; }
.model-value { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-panel {
  position: fixed;
  left: 5%; right: 5%; top: 10%; bottom: 10%;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius);
  z-index: 101;
  padding: 32rpx;
  overflow-y: auto;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.modal-title { font-size: 34rpx; font-weight: bold; color: var(--text); margin-bottom: 28rpx; text-align: center; }

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text); margin-bottom: 8rpx; }
.form-input {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.form-textarea {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: var(--text);
  width: 100%;
  min-height: 100rpx;
  box-sizing: border-box;
}
.picker-val {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
}
.show-key-switch { display: inline-block; vertical-align: middle; margin-left: 8rpx; transform: scale(0.7); }
.show-key-label { font-size: 22rpx; color: var(--text-secondary); vertical-align: middle; }

.form-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.form-actions button { flex: 1; }

.weui-btn_default { background: rgba(255,255,255,0.08); border: 1rpx solid var(--glass-border); color: var(--text); }
.weui-btn_primary { background: rgba(108,92,231,0.3); border: 1rpx solid rgba(108,92,231,0.4); color: #fff; }
.weui-btn::after { border: none; }
