<view class="container">
  <view class="glass-bg"></view>
  <view class="admin-title">配置管理</view>
  <view class="tab-bar">
    <view class="tab {{activeTab==='price'?'active':''}}" bindtap="switchTab" data-tab="price">消耗定价</view>
    <view class="tab {{activeTab==='packages'?'active':''}}" bindtap="switchTab" data-tab="packages">套餐</view>
    <view class="tab {{activeTab==='subscribe'?'active':''}}" bindtap="switchTab" data-tab="subscribe">订阅</view>
    <view class="tab {{activeTab==='invite'?'active':''}}" bindtap="switchTab" data-tab="invite">邀请</view>
    <view class="tab {{activeTab==='ad'?'active':''}}" bindtap="switchTab" data-tab="ad">广告</view>
  </view>

  <!-- 消耗定价 Tab -->
  <view wx:if="{{activeTab==='price'}}" class="tab-content">
    <view class="tab-hint">设置每个美化选项的单次消耗代币数</view>
    <block wx:for="{{pricingGroups}}" wx:key="key" wx:for-item="group">
      <view class="price-group-title">{{group.label}}</view>
      <view class="setting-item" wx:for="{{group.items}}" wx:key="_id" wx:for-item="sub" wx:for-index="sidx">
        <text class="setting-label">{{sub.subLabel}}</text>
        <input class="setting-input" type="number" value="{{sub.tokens}}" data-id="{{sub._id}}" data-field="tokens" bindblur="updatePricing" />
        <text class="setting-unit">代币/次</text>
      </view>
    </block>
  </view>

  <!-- 套餐 Tab -->
  <view wx:if="{{activeTab==='packages'}}" class="tab-content">
    <view class="setting-item" wx:for="{{packages}}" wx:key="_id" data-id="{{item._id}}" bindtap="editPackage">
      <view class="pkg-info">
        <view class="pkg-left">
          <view class="pkg-name">{{item.name}}</view>
          <view class="pkg-detail">{{item.tokens}}代币<span wx:if="{{item.bonus}}"> + 赠{{item.bonus}}</span> · ¥{{item.priceInYuan}}</view>
        </view>
        <switch checked="{{item.is_active}}" data-id="{{item._id}}" catchtap="updatePackage" />
      </view>
    </view>
    <button class="weui-btn weui-btn_mini weui-btn_default" bindtap="showAddPackage">+ 添加套餐</button>
  </view>

  <!-- 订阅 Tab -->
  <view wx:if="{{activeTab==='subscribe'}}" class="tab-content">
    <view class="setting-item"><text class="setting-label">月费(分)</text>
      <input class="setting-input" type="number" value="{{subConfig.price}}" data-field="price" bindblur="updateSub" /></view>
    <view class="setting-item"><text class="setting-label">每日赠送</text>
      <input class="setting-input" type="number" value="{{subConfig.daily_tokens}}" data-field="daily_tokens" bindblur="updateSub" /></view>
    <view class="setting-item"><text class="setting-label">订阅模板ID</text>
      <input class="setting-input" value="{{subConfig.wx_template_id}}" data-field="wx_template_id" bindblur="updateSubStr" placeholder="微信订阅消息模板ID" /></view>
  </view>

  <!-- 邀请 Tab -->
  <view wx:if="{{activeTab==='invite'}}" class="tab-content">
    <view class="setting-item"><text class="setting-label">邀请人奖励</text>
      <input class="setting-input" type="number" value="{{inviteConfig.inviter_reward}}" data-field="inviter_reward" bindblur="updateInvite" /></view>
    <view class="setting-item"><text class="setting-label">被邀请人奖励</text>
      <input class="setting-input" type="number" value="{{inviteConfig.invitee_reward}}" data-field="invitee_reward" bindblur="updateInvite" /></view>
  </view>

  <!-- 广告 Tab -->
  <view wx:if="{{activeTab==='ad'}}" class="tab-content">
    <view class="setting-item"><text class="setting-label">每日可领次数</text>
      <input class="setting-input" type="number" value="{{adConfig.daily_limit}}" data-field="daily_limit" bindblur="updateAd" /></view>
    <view class="setting-item"><text class="setting-label">每次奖励代币</text>
      <input class="setting-input" type="number" value="{{adConfig.reward_tokens}}" data-field="reward_tokens" bindblur="updateAd" /></view>
    <view class="setting-item"><text class="setting-label">功能开关</text>
      <switch checked="{{adConfig.is_active}}" bindchange="toggleAdActive" /></view>
  </view>
</view>

<!-- 套餐编辑弹窗 -->
<view class="modal-mask" wx:if="{{showForm}}" catchtap="hideForm"></view>
<view class="modal-panel" wx:if="{{showForm}}">
  <view class="modal-title">{{editingId ? '编辑套餐' : '添加套餐'}}</view>

  <view class="form-item">
    <view class="form-label">套餐名称</view>
    <input class="form-input" placeholder="如：100代币包" value="{{formData.name}}" bindinput="onFieldChange" data-field="name" />
  </view>

  <view class="form-item">
    <view class="form-label">价格（分）</view>
    <input class="form-input" type="number" placeholder="1999" value="{{formData.price}}" bindinput="onNumChange" data-field="price" />
    <view class="form-hint">¥{{priceInYuan}}</view>
  </view>

  <view class="form-item">
    <view class="form-label">代币数</view>
    <input class="form-input" type="number" placeholder="100" value="{{formData.tokens}}" bindinput="onNumChange" data-field="tokens" />
  </view>

  <view class="form-item">
    <view class="form-label">赠送代币</view>
    <input class="form-input" type="number" placeholder="0" value="{{formData.bonus}}" bindinput="onNumChange" data-field="bonus" />
  </view>

  <view class="form-actions">
    <button class="weui-btn weui-btn_default" bindtap="hideForm">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="savePackage" loading="{{saving}}">保存</button>
  </view>
</view>
