.tab-bar {
  display: flex;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: var(--text-secondary); }
.tab.active { color: var(--primary); font-weight: bold; border-bottom: 4rpx solid var(--primary); }
.tab-content {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.tab-hint { font-size: 22rpx; color: var(--text-hint); margin-bottom: 12rpx; }
.price-group-title { font-size: 28rpx; font-weight: bold; color: var(--text); margin: 24rpx 0 8rpx; padding-top: 16rpx; border-top: 2rpx solid rgba(255,255,255,0.1); }
.price-group-title:first-child { border-top: none; margin-top: 0; padding-top: 0; }
.setting-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.1); }
.setting-label { width: 200rpx; font-size: 26rpx; color: var(--text); }
.setting-input {
  flex: 1;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
}
.setting-unit { font-size: 22rpx; color: var(--text-hint); margin-left: 12rpx; }

.pkg-info { display: flex; justify-content: space-between; align-items: center; width: 100%; }
.pkg-name { font-size: 28rpx; font-weight: bold; color: var(--text); }
.pkg-detail { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

/* modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-panel {
  position: fixed;
  left: 5%; right: 5%; top: 15%;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius);
  z-index: 101;
  padding: 32rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.modal-title { font-size: 34rpx; font-weight: bold; color: var(--text); margin-bottom: 28rpx; text-align: center; }

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text); margin-bottom: 8rpx; }
.form-input {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.form-hint { font-size: 22rpx; color: var(--primary); margin-top: 4rpx; }

.form-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.form-actions button { flex: 1; }

.weui-btn_default { background: rgba(255,255,255,0.08); border: 1rpx solid var(--glass-border); color: var(--text); }
.weui-btn_primary { background: rgba(108,92,231,0.3); border: 1rpx solid rgba(108,92,231,0.4); color: #fff; }
.weui-btn::after { border: none; }
