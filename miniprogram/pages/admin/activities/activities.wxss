.activity-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.act-name { font-size: 28rpx; font-weight: bold; color: var(--text); margin-bottom: 4rpx; }
.act-desc { font-size: 22rpx; color: var(--text-secondary); margin-bottom: 4rpx; }
.act-detail { font-size: 22rpx; color: var(--text-secondary); margin-bottom: 12rpx; }
.act-actions { display: flex; justify-content: space-between; align-items: center; }

/* modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-panel {
  position: fixed;
  left: 5%; right: 5%; top: 8%; bottom: 8%;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius);
  z-index: 101;
  padding: 32rpx;
  overflow-y: auto;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.modal-title { font-size: 34rpx; font-weight: bold; color: var(--text); margin-bottom: 28rpx; text-align: center; }

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text); margin-bottom: 8rpx; }
.form-input {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.picker-val {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-btn);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text);
}

.form-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.form-actions button { flex: 1; }

.weui-btn_default { background: rgba(255,255,255,0.08); border: 1rpx solid var(--glass-border); color: var(--text); }
.weui-btn_primary { background: rgba(108,92,231,0.3); border: 1rpx solid rgba(108,92,231,0.4); color: #fff; }
.weui-btn_warn { background: rgba(250,81,81,0.3); border: 1rpx solid rgba(250,81,81,0.4); color: #fff; }
.weui-btn::after { border: none; }
