.admin-title { font-size: 36rpx; font-weight: bold; color: var(--text); margin-bottom: 24rpx; position: relative; z-index: 1; }
.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 32rpx; position: relative; z-index: 1; }
.stat-card {
  width: calc(50% - 8rpx);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 32rpx;
  text-align: center;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.stat-num { font-size: 48rpx; font-weight: bold; color: var(--primary); }
.stat-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }
.nav-grid { display: flex; flex-direction: column; gap: 16rpx; position: relative; z-index: 1; }
.nav-btn {
  background: rgba(108,92,231,0.3);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(108,92,231,0.4);
  color: #fff;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  padding: 20rpx;
}
.nav-btn::after { border: none; }
