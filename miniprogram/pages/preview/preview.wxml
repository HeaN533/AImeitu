<view class="container pv-container">
  <view class="pv-img-wrap">
    <image class="pv-img" src="{{previewUrl}}" mode="aspectFit" wx:if="{{previewUrl}}" />
    <view class="pv-watermark-stamp">AI美化预览</view>
  </view>

  <view class="pv-info">
    <text class="pv-info-icon">💡</text>
    <text>预览图含水印，下载原图消耗 {{price}} 代币 [v2]</text>
  </view>

  <button class="pv-primary" bindtap="download" loading="{{downloading}}">
    下载原图 · {{price}} 代币
  </button>
  <button class="pv-ghost" bindtap="retry">重新处理</button>
  <button class="pv-link" bindtap="goHome">返回首页</button>
</view>
