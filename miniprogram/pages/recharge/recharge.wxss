.bal-card {
  background: linear-gradient(135deg, #07c160, #05d68c);
  border-radius: var(--radius);
  padding: 36rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.25);
}
.bal-label { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.bal-num { font-size: 64rpx; font-weight: 800; color: #fff; margin-top: 8rpx; }

.pkg-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 32rpx; }
.pkg-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 3rpx solid transparent;
  position: relative;
  overflow: hidden;
}
.pkg-card.selected { border-color: var(--primary); background: var(--primary-light); }
.pkg-badge {
  position: absolute; top: 0; right: 0;
  background: var(--warn); color: #fff;
  font-size: 20rpx; padding: 6rpx 20rpx;
  border-radius: 0 var(--radius) 0 var(--radius-sm);
}
.pkg-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.pkg-tokens { font-size: 24rpx; color: var(--text-secondary); }
.pkg-price { font-size: 40rpx; font-weight: 800; color: var(--primary); }

.buy-btn {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx;
  border: none;
}
.buy-btn[disabled] { background: #ccc; }
