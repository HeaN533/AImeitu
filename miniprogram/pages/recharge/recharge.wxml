<view class="container">
  <view class="bal-card">
    <view class="bal-label">当前代币</view>
    <view class="bal-num">{{tokens}}</view>
  </view>

  <view class="pkg-list">
    <view class="pkg-card {{item._id === selected ? 'selected' : ''}}" wx:for="{{packages}}" wx:key="_id" data-id="{{item._id}}" bindtap="selectPackage">
      <view class="pkg-badge" wx:if="{{item.bonus}}">赠{{item.bonus}}代币</view>
      <view class="pkg-name">{{item.name}}</view>
      <view class="pkg-tokens">{{item.tokens}} 代币</view>
      <view class="pkg-price">¥{{item.priceInYuan}}</view>
    </view>
  </view>

  <button class="buy-btn" bindtap="buy" disabled="{{!selected}}">
    {{selected ? '立即购买' : '请选择套餐'}}
  </button>
</view>
