<view class="container">
  <view class="user-card">
    <view class="avatar-wrap"><text class="avatar-icon">👤</text></view>
    <view class="user-info">
      <view class="user-name">{{isAdmin ? '管理员' : '普通用户'}}</view>
      <view class="user-id">ID: {{userId}}</view>
    </view>
  </view>

  <view class="token-card">
    <view class="token-row">
      <view class="token-item">
        <text class="token-num">{{tokens}}</text>
        <text class="token-lbl">永久代币</text>
      </view>
      <view class="token-divider"></view>
      <view class="token-item">
        <text class="token-num warn">{{activityTokens}}</text>
        <text class="token-lbl">限时代币</text>
      </view>
    </view>
    <button class="recharge-btn" bindtap="goRecharge">充值代币</button>
  </view>

  <view class="menu-card">
    <view class="m-item" bindtap="goHistory">
      <text class="m-icon">📋</text><text class="m-text">历史记录</text><text class="m-arrow">›</text>
    </view>
    <view class="m-item" bindtap="dailyCheckIn">
      <text class="m-icon">🎁</text><text class="m-text">每日签到</text><text class="m-arrow">›</text>
    </view>
    <view class="m-item" bindtap="claimActivity">
      <text class="m-icon">🎉</text><text class="m-text">领取活动奖励</text><text class="m-arrow">›</text>
    </view>
    <button class="m-item m-share-btn" open-type="share">
      <text class="m-icon">💌</text><text class="m-text">邀请好友<text class="m-sub">双方各得奖励</text></text><text class="m-arrow">›</text>
    </button>
    <view class="m-item" bindtap="watchAd">
      <text class="m-icon">📺</text><text class="m-text">看广告领代币<text class="m-sub">今日剩余 {{adRemaining}} 次</text></text><text class="m-arrow">›</text>
    </view>
    <view class="m-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <text class="m-icon">⚙️</text><text class="m-text">管理后台</text><text class="m-arrow">›</text>
    </view>
  </view>

  <view class="records-card">
    <view class="section-head">最近流水</view>
    <block wx:for="{{recentRecords}}" wx:key="_id">
      <view class="rec-item">
        <view class="rec-left">
          <view class="rec-type">{{item.typeLabel}}</view>
          <view class="rec-date">{{item.dateStr}}</view>
        </view>
        <view class="rec-amount {{item.amount > 0 ? 'in' : 'out'}}">
          {{item.amount > 0 ? '+' : ''}}{{item.amount}}
        </view>
      </view>
      <view class="rec-divider" wx:if="{{index < recentRecords.length - 1}}"></view>
    </block>
    <view class="empty-state" wx:if="{{recentRecords.length === 0}}">
      <text class="icon">📭</text><text class="text">暂无流水记录</text>
    </view>
  </view>
</view>
