<view class="container">
  <view class="bg-gradient"></view>
  <view class="hero">
    <view class="hero-title">AI 图片美化</view>
    <view class="hero-sub">一键智能修图 · 让每张照片更出彩</view>
    <token-badge tokens="{{tokens}}" activityTokens="{{activityTokens}}" />
  </view>

  <view class="category-grid">
    <view class="c-card c-beautify" wx:for="{{categories}}" wx:key="key"
      data-category="{{item.key}}" bindtap="goProcess">
      <view class="c-icon-wrap"><text class="c-icon">{{item.icon}}</text></view>
      <view class="c-name">{{item.label}}</view>
      <view class="c-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
