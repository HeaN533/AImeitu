.bg-gradient {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 520rpx;
  background: linear-gradient(180deg, #e8fce8 0%, #f0faf0 50%, #f5f5f7 100%);
  z-index: 0;
  pointer-events: none;
}
.hero {
  padding: 40rpx 0 32rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 8rpx 0 24rpx;
}
.category-grid {
  position: relative;
  z-index: 1;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  width: 100%;
}

.c-card {
  width: calc(50% - 10rpx);
  border-radius: var(--radius);
  padding: 40rpx 16rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
}
.c-beautify { background: linear-gradient(160deg, #fff5f7 0%, #fff 100%); }
.c-card:nth-child(2) { background: linear-gradient(160deg, #f0f4ff 0%, #fff 100%); }
.c-card:nth-child(3) { background: linear-gradient(160deg, #faf0ff 0%, #fff 100%); }
.c-card:nth-child(4) { background: linear-gradient(160deg, #fff9f0 0%, #fff 100%); }

.c-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.c-beautify .c-icon-wrap { background: #ffe8ec; }
.c-card:nth-child(2) .c-icon-wrap { background: #e4ecff; }
.c-card:nth-child(3) .c-icon-wrap { background: #f0e4ff; }
.c-card:nth-child(4) .c-icon-wrap { background: #fff0d0; }

.c-icon { font-size: 52rpx; }
.c-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}
.c-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}
