.hero {
  padding: 48rpx 0 36rpx;
  text-align: center;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 12rpx 0 28rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.c-card {
  width: calc(50% - 10rpx);
  border-radius: var(--radius);
  padding: 36rpx 24rpx 28rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.c-beautify { background: linear-gradient(160deg, #fff5f7 0%, #fff 100%); }
.c-card:nth-child(2) { background: linear-gradient(160deg, #f0f4ff 0%, #fff 100%); }
.c-card:nth-child(3) { background: linear-gradient(160deg, #faf0ff 0%, #fff 100%); }
.c-card:nth-child(4) { background: linear-gradient(160deg, #fff9f0 0%, #fff 100%); }

.c-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.c-beautify .c-icon-wrap { background: #fff0f3; }
.c-card:nth-child(2) .c-icon-wrap { background: #edf2ff; }
.c-card:nth-child(3) .c-icon-wrap { background: #f5edff; }
.c-card:nth-child(4) .c-icon-wrap { background: #fff4e0; }

.c-icon { font-size: 52rpx; }
.c-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}
.c-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}
