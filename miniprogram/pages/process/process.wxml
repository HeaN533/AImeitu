<view class="container">
  <view class="step {{fileID ? 'done' : 'active'}}">
    <view class="step-num">1</view>
    <view class="step-label">上传图片</view>
  </view>
  <image-uploader id="uploader" bind:upload="onImageUploaded" />

  <view class="step {{subType ? 'done' : (fileID ? 'active' : '')}}" wx:if="{{fileID}}">
    <view class="step-num">2</view>
    <view class="step-label">选择效果</view>
  </view>
  <effect-picker wx:if="{{fileID}}" initial-category="{{category}}" bind:select="onEffectSelect" />

  <button class="go-btn" wx:if="{{fileID && subType}}" bindtap="startProcess" loading="{{processing}}">
    {{processing ? 'AI 处理中...' : '✨ 开始美化'}}
  </button>
</view>
