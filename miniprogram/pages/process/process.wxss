.step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 36rpx 0 20rpx;
}
.step-num {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: #ddd;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.step.active .step-num { background: var(--primary); }
.step.done .step-num { background: var(--primary); }
.step-label { font-size: 30rpx; font-weight: 700; color: var(--text); }
.step.active .step-label { color: var(--text); }
.step.done .step-label { color: var(--primary); }

.go-btn {
  margin-top: 48rpx;
  width: 100%;
  background: linear-gradient(135deg, #07c160, #05d68c);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
}
