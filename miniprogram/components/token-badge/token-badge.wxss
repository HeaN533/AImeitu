.badge-wrap { display: flex; justify-content: center; gap: 24rpx; }
.b-item { text-align: center; }
.b-num { font-size: 36rpx; font-weight: 700; color: var(--primary); }
.b-num.act { color: var(--warn); }
.b-tag { font-size: 20rpx; color: var(--text-hint); display: block; }
.b-tag.act { color: var(--warn); }
