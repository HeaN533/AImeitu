.picker { width: 100%; }
.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--card);
  border-radius: 44rpx;
  margin-right: 16rpx;
  transition: all 0.2s;
}
.tab.on { color: #fff; background: var(--primary); font-weight: 600; }

.subs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sub {
  width: calc(50% - 8rpx);
  padding: 28rpx 16rpx;
  background: var(--card);
  border-radius: var(--radius);
  text-align: center;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}
.sub.on { border-color: var(--primary); background: var(--primary-light); }
.sub-icon { font-size: 40rpx; margin-bottom: 12rpx; }
.sub-name { font-size: 26rpx; font-weight: 600; color: var(--text); margin-bottom: 6rpx; }
.sub-price { font-size: 22rpx; color: var(--text-secondary); }
