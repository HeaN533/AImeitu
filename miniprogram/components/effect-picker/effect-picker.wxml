<view class="picker">
  <scroll-view scroll-x class="tabs">
    <view class="tab {{activeCategory === item.key ? 'on' : ''}}"
      wx:for="{{categories}}" wx:key="key"
      data-key="{{item.key}}" bindtap="switchCategory">{{item.label}}</view>
  </scroll-view>

  <!-- 人像美化：slider + 滤镜选择 -->
  <view wx:if="{{isBeautify}}" class="beautify-panel">
    <view class="b-slider-item">
      <view class="b-slider-label">美白程度</view>
      <view class="b-slider-row">
        <view class="b-slider-gap"></view>
        <slider min="0" max="100" value="{{bParams.whitening}}" data-field="whitening" bindchanging="onSliderChange" activeColor="#6c5ce7" backgroundColor="rgba(255,255,255,0.15)" block-size="22" />
        <text class="b-slider-val">{{bParams.whitening}}</text>
      </view>
    </view>
    <view class="b-slider-item">
      <view class="b-slider-label">磨皮程度</view>
      <view class="b-slider-row">
        <view class="b-slider-gap"></view>
        <slider min="0" max="100" value="{{bParams.smoothing}}" data-field="smoothing" bindchanging="onSliderChange" activeColor="#6c5ce7" backgroundColor="rgba(255,255,255,0.15)" block-size="22" />
        <text class="b-slider-val">{{bParams.smoothing}}</text>
      </view>
    </view>
    <view class="b-slider-item">
      <view class="b-slider-label">瘦脸程度</view>
      <view class="b-slider-row">
        <view class="b-slider-gap"></view>
        <slider min="0" max="100" value="{{bParams.thinface}}" data-field="thinface" bindchanging="onSliderChange" activeColor="#6c5ce7" backgroundColor="rgba(255,255,255,0.15)" block-size="22" />
        <text class="b-slider-val">{{bParams.thinface}}</text>
      </view>
    </view>
    <view class="b-slider-item">
      <view class="b-slider-label">大眼程度</view>
      <view class="b-slider-row">
        <view class="b-slider-gap"></view>
        <slider min="0" max="100" value="{{bParams.enlarge_eye}}" data-field="enlarge_eye" bindchanging="onSliderChange" activeColor="#6c5ce7" backgroundColor="rgba(255,255,255,0.15)" block-size="22" />
        <text class="b-slider-val">{{bParams.enlarge_eye}}</text>
      </view>
    </view>
    <view class="b-filter-row">
      <text class="b-filter-label">滤镜</text>
      <view class="b-filter-wrap">
        <view class="b-filter-val" bindtap="toggleFilterList">{{filterOptions[bFilterIdx].label}} ▼</view>
        <view class="b-filter-drop" wx:if="{{showFilterList}}">
          <view class="b-filter-opt {{bFilterIdx === idx ? 'on' : ''}}"
            wx:for="{{filterOptions}}" wx:key="key" wx:for-index="idx"
            data-idx="{{idx}}" bindtap="selectFilter">{{item.label}}</view>
        </view>
      </view>
    </view>
    <button class="b-confirm-btn" bindtap="confirmBeautify">
      使用此参数 · {{priceMap['beautify_beautify'] || defaultPrices['beautify']}} 代币
    </button>
  </view>

  <!-- 风格/滤镜转换：子选项网格 -->
  <view class="subs" wx:else>
    <view class="sub {{selectedSubType === item.key ? 'on' : ''}}"
      wx:for="{{currentSubTypes}}" wx:key="key"
      data-key="{{item.key}}" bindtap="selectSubType">
      <view class="sub-icon">
        <text wx:if="{{activeCategory === 'filter'}}">📸</text>
        <text wx:elif="{{activeCategory === 'style'}}">🎭</text>
        <text wx:else>🎨</text>
      </view>
      <view class="sub-name">{{item.label}}</view>
      <view class="sub-price">{{priceMap[activeCategory + '_' + item.key] || defaultPrices[activeCategory]}} 代币</view>
    </view>
  </view>
</view>
