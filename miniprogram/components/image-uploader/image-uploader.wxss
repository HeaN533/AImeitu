.uploader { width: 100%; }
.up-zone {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 400rpx;
  background: var(--card);
  border: 3rpx dashed #e0e0e0;
  border-radius: var(--radius);
}
.up-plus { font-size: 80rpx; color: #ccc; line-height: 1; }
.up-text { font-size: 28rpx; color: var(--text-secondary); margin-top: 12rpx; }
.up-hint { font-size: 22rpx; color: var(--text-hint); margin-top: 8rpx; }
.up-preview { position: relative; }
.up-img { width: 100%; height: 500rpx; border-radius: var(--radius); }
.up-btns { display: flex; justify-content: center; gap: 24rpx; margin-top: 24rpx; }
.up-repick {
  padding: 16rpx 36rpx;
  border-radius: 44rpx;
  border: 2rpx solid #ddd;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.up-confirm {
  padding: 16rpx 36rpx;
  border-radius: 44rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}
.up-err { color: var(--danger); font-size: 24rpx; margin-top: 12rpx; text-align: center; }
