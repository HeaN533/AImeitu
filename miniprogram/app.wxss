page {
  background: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --primary: #07c160;
  --primary-dark: #06ad56;
  --primary-light: #e8fce8;
  --danger: #fa5151;
  --warn: #ff9500;
  --text: #1a1a1a;
  --text-secondary: #888;
  --text-hint: #bbb;
  --bg: #f5f5f7;
  --card: #fff;
  --divider: #f0f0f0;
  --shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  --radius: 20rpx;
  --radius-sm: 12rpx;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
}

/* card base */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

/* empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.empty-state .icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-state .text { font-size: 28rpx; color: var(--text-secondary); }

/* divider */
.divider { height: 1rpx; background: var(--divider); margin: 0 -28rpx; }
